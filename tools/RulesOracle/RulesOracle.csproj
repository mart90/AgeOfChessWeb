<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plays random games with the server's real GameLogic and dumps every position's legal
       moves, so the Rust engine's move generator can be validated against it. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>CS8981;CS1998</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\AgeOfChess.Server\GameLogic\**\*.cs"
             Exclude="..\..\AgeOfChess.Server\GameLogic\ServerGame.cs;..\..\AgeOfChess.Server\GameLogic\BiddingSession.cs"
             LinkBase="GameLogic" />
  </ItemGroup>

</Project>
